ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -pthread -B /opt/conda/envs/pointkan/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /opt/conda/envs/pointkan/include -fPIC -O2 -isystem /opt/conda/envs/pointkan/include -fPIC -I/opt/conda/envs/pointkan/lib/python3.8/site-packages/torch/include -I/opt/conda/envs/pointkan/lib/python3.8/site-packages/torch/include/torch/csrc/api/include -I/opt/conda/envs/pointkan/lib/python3.8/site-packages/torch/include/TH -I/opt/conda/envs/pointkan/lib/python3.8/site-packages/torch/include/THC -I/usr/local/cuda/include -I/opt/conda/envs/pointkan/include/python3.8 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=kat_rational_cu -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/opt/conda/envs/pointkan/lib/python3.8/site-packages/torch/include -I/opt/conda/envs/pointkan/lib/python3.8/site-packages/torch/include/torch/csrc/api/include -I/opt/conda/envs/pointkan/lib/python3.8/site-packages/torch/include/TH -I/opt/conda/envs/pointkan/lib/python3.8/site-packages/torch/include/THC -I/usr/local/cuda/include -I/opt/conda/envs/pointkan/include/python3.8 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=kat_rational_cu -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_80,code=compute_80 -gencode=arch=compute_80,code=sm_80 -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags





build /workspace/PointKAN-pytorch/rational_kat_cu/build/temp.linux-x86_64-3.8/src/rational.o: compile /workspace/PointKAN-pytorch/rational_kat_cu/src/rational.cpp
build /workspace/PointKAN-pytorch/rational_kat_cu/build/temp.linux-x86_64-3.8/src/rational_kernel.o: cuda_compile /workspace/PointKAN-pytorch/rational_kat_cu/src/rational_kernel.cu
build /workspace/PointKAN-pytorch/rational_kat_cu/build/temp.linux-x86_64-3.8/src/rational_kernel_group.o: cuda_compile /workspace/PointKAN-pytorch/rational_kat_cu/src/rational_kernel_group.cu







